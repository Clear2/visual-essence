VISUAL_ESSENCE_HOST=0.0.0.0
VISUAL_ESSENCE_PORT=8000
VISUAL_ESSENCE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VISUAL_ESSENCE_UPSTREAM_TIMEOUT_SECONDS=12
VISUAL_ESSENCE_CONFIG_PATH=../config.yaml
